        },
        "Transforms": [
          {
            "PathPattern": "swagger/{**catch-all}"
          }
        ]
      },
      
      "kardex": {
        "ClusterId": "commerce-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/kardex/{**catch-all}"
        }
      },

      "products": {
        "ClusterId": "commerce-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },

      "purchases": {
        "ClusterId": "commerce-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/purchases/{**catch-all}"
        }
      },

      "sales": {
        "ClusterId": "commerce-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
